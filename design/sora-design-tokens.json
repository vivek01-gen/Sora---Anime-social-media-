{
  "theme": "sora-cyberpunk-dark",
  "colors": {
    "bg": {
      "base900": "#070A14",
      "base800": "#0C1020",
      "gradStart": "#0A1233",
      "gradEnd": "#24164D"
    },
    "accent": {
      "cyan": "#29E7FF",
      "violet": "#9C5CFF",
      "pink": "#FF4FD8"
    },
    "text": {
      "primary": "#F4F7FF",
      "secondary": "#B8C1E0"
    },
    "state": {
      "success": "#40E8A0",
      "warn": "#FFBF4D",
      "error": "#FF5F7A"
    }
  },
  "radius": { "sm": 12, "md": 16, "lg": 22, "xl": 28, "pill": 999 },
  "blur": { "card": 16, "nav": 24, "modal": 24 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "typography": {
    "fontPrimary": "Inter, SF Pro, system-ui, sans-serif",
    "fontDisplay": "Space Grotesk, Inter, sans-serif",
    "scale": {
      "h1": { "size": 28, "lineHeight": 34, "weight": 600 },
      "h2": { "size": 22, "lineHeight": 28, "weight": 600 },
      "title": { "size": 18, "lineHeight": 24, "weight": 500 },
      "body": { "size": 15, "lineHeight": 22, "weight": 400 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 400 },
      "micro": { "size": 11, "lineHeight": 14, "weight": 500 }
    }
  },
  "motion": {
    "durationFast": 180,
    "durationBase": 220,
    "durationSlow": 260,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
